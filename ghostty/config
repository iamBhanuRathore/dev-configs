# Font configuration (JetBrains Mono Nerd Font — polished, easy on eyes, matches reference screenshot)
# Family name must match Ghostty discovery: "JetBrainsMono Nerd Font Mono"
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 13.5
font-thicken = false
font-feature = "+liga"
font-feature = "+calt"
# Breathing room between lines — JetBrains Mono has a tall x-height, this keeps it airy like VS Code/Antigravity
adjust-cell-height = 8%
bold-is-bright = true
minimum-contrast = 1.1


# Window Appearance
window-padding-x = 0
window-padding-y = 0
window-height = 40
window-width = 120
window-decoration = true
macos-titlebar-style = transparent

# Background
background-opacity = 0.95
background-blur-radius = 20

# Cursor
cursor-style = block
cursor-style-blink = true

# Mouse
mouse-hide-while-typing = true

# Keybindings

# Developer Experience Enhancements
macos-option-as-alt = true
copy-on-select = true
scrollback-limit = 10000
confirm-close-surface = false
shell-integration = detect
